@model RoomDetailsViewModel
@{
    ViewData["Title"] = Model.Room.Name;
    var date = Model.Schedule.Date;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var prev = date.AddDays(-1);
    var next = date.AddDays(1);
    var freeCount = Model.Schedule.Slots.Count(s => s.IsFree);
    var returnUrl = $"/Rooms/Details/{Model.Room.Id}?date={date:yyyy-MM-dd}";
}
<div class="page">
    <div class="container">
        <a class="crumb" asp-action="Index">@Icons.ChevronLeft(16) ყველა ოთახი</a>
        <partial name="_Alerts" />

        <div class="detail-grid">
            <aside class="detail-aside">
                <div class="cover @RoomStyle.Cover(Model.Room.Id)">
                    <div class="cover-top">
                        <span class="cover-badge">@RoomStyle.SizeLabel(Model.Room.Capacity)</span>
                    </div>
                    <div>
                        <h1 class="cover-title">@Model.Room.Name</h1>
                        <div class="cover-rule"></div>
                    </div>
                </div>
                <div class="facts">
                    <dl>
                        <div><dt>მდებარეობა</dt><dd>@Model.Room.Location</dd></div>
                        <div><dt>ტევადობა</dt><dd>@RoomStyle.Seats(Model.Room.Capacity)</dd></div>
                        <div><dt>სლოტი</dt><dd>1 საათი</dd></div>
                        <div><dt>თავისუფალი დღეს</dt><dd>@freeCount / @Model.Schedule.Slots.Count</dd></div>
                    </dl>
                </div>
            </aside>

            <section class="panel" aria-labelledby="schedule-title">
                <div class="panel-head">
                    <div>
                        <h2 id="schedule-title">განრიგი</h2>
                        <span class="muted small">@RoomStyle.LongDate(date)</span>
                    </div>
                    <form class="date-nav" method="get" asp-action="Details" asp-route-id="@Model.Room.Id">
                        <a class="icon-btn @(prev < Model.MinDate ? "disabled" : "")" aria-label="წინა დღე"
                           asp-action="Details" asp-route-id="@Model.Room.Id" asp-route-date="@prev.ToString("yyyy-MM-dd")">@Icons.ChevronLeft()</a>
                        <label for="date" class="visually-hidden">თარიღი</label>
                        <input type="date" id="date" name="date"
                               value="@date.ToString("yyyy-MM-dd")"
                               min="@Model.MinDate.ToString("yyyy-MM-dd")"
                               max="@Model.MaxDate.ToString("yyyy-MM-dd")"
                               onchange="this.form.submit()" />
                        <a class="icon-btn @(next > Model.MaxDate ? "disabled" : "")" aria-label="შემდეგი დღე"
                           asp-action="Details" asp-route-id="@Model.Room.Id" asp-route-date="@next.ToString("yyyy-MM-dd")">@Icons.ChevronRight()</a>
                        <noscript><button class="btn btn-sm" type="submit">ჩვენება</button></noscript>
                    </form>
                </div>

                <div class="legend">
                    <span><i class="dot dot-free"></i> თავისუფალი</span>
                    <span><i class="dot dot-booked"></i> დაკავებული</span>
                    <span><i class="dot dot-past"></i> გასული</span>
                </div>

                @if (!Model.Schedule.HasFreeSlots)
                {
                    <div class="alert alert-warn" data-testid="no-free-slots">@Icons.Info(18) <span>ამ დღეს თავისუფალი დრო აღარ არის. სცადე სხვა თარიღი.</span></div>
                }

                @if (!signedIn)
                {
                    <div class="alert alert-info">@Icons.Lock(18) <span>დასაჯავშნად <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">შედი სისტემაში</a> ან <a asp-controller="Account" asp-action="Register">შექმენი ანგარიში</a>.</span></div>
                }

                <div class="slots">
                    @foreach (var slot in Model.Schedule.Slots)
                    {
                        var css = slot.State switch
                        {
                            SlotState.Free => "slot-free",
                            SlotState.Booked => "slot-booked",
                            _ => "slot-past"
                        };
                        var label = slot.State switch
                        {
                            SlotState.Free => "თავისუფალია",
                            SlotState.Booked => "დაკავებულია",
                            _ => "გასულია"
                        };
                        <div class="slot @css">
                            <span class="slot-time">@slot.Label</span>
                            <span class="slot-state">@label</span>
                            @if (slot.IsFree && signedIn)
                            {
                                <form asp-controller="Bookings" asp-action="Create" method="post">
                                    <input type="hidden" name="roomId" value="@Model.Room.Id" />
                                    <input type="hidden" name="date" value="@date.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="startHour" value="@slot.StartHour" />
                                    <button type="submit" class="btn btn-sm btn-block">დაჯავშნა</button>
                                </form>
                            }
                        </div>
                    }
                </div>

                <div class="rules">
                    <div class="rule">@Icons.Clock() <span>ერთი ჯავშანი = 1 საათი, 08:00-დან 22:00-მდე.</span></div>
                    <div class="rule">@Icons.Bookmark() <span>დღეში მაქსიმუმ 3 ჯავშანი ერთ სტუდენტზე.</span></div>
                    <div class="rule">@Icons.Calendar() <span>დაჯავშნა შეიძლება 14 დღით ადრე.</span></div>
                </div>
            </section>
        </div>
    </div>
</div>
