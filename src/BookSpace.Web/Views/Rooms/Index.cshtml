@model RoomListViewModel
@{
    ViewData["Title"] = "ოთახები";
    var isAdmin = User.IsInRole(Roles.Admin);
    (string? key, string label)[] sizes =
    {
        (null, "ყველა"), ("solo", "ინდივიდუალური"), ("small", "მცირე ჯგუფი"), ("group", "ჯგუფური")
    };
}
<div class="page">
    <div class="container">
        <partial name="_Alerts" />

        <div class="page-head">
            <div>
                <span class="eyebrow">კატალოგი</span>
                <h1>სასწავლო ოთახები</h1>
                <p>აირჩიე ოთახი და ნახე მისი თავისუფალი საათები.</p>
            </div>
            @if (isAdmin)
            {
                <a class="btn" asp-action="Create">@Icons.Plus() ოთახის დამატება</a>
            }
        </div>

        <form class="filters" method="get" asp-action="Index" role="search">
            <div class="search">
                @Icons.Search()
                <label for="q" class="visually-hidden">ძებნა</label>
                <input id="q" name="q" type="search" value="@Model.Query" placeholder="სახელი ან მდებარეობა…" />
            </div>
            @if (!string.IsNullOrEmpty(Model.Size))
            {
                <input type="hidden" name="size" value="@Model.Size" />
            }
            <div class="chips" aria-label="ზომა">
                @foreach (var s in sizes)
                {
                    <a class="chip @(Model.Size == s.key ? "active" : "")"
                       asp-action="Index" asp-route-q="@Model.Query" asp-route-size="@s.key">@s.label</a>
                }
            </div>
            <button class="btn btn-sm" type="submit">ძებნა</button>
        </form>

        @if (Model.IsFiltered && Model.Rooms.Count > 0)
        {
            <p class="result-count">ნაპოვნია @Model.Rooms.Count ოთახი @Model.TotalCount-დან · <a asp-action="Index">ფილტრის მოხსნა</a></p>
        }

        @if (Model.TotalCount == 0)
        {
            <div class="empty" data-testid="empty-rooms">
                <div class="empty-icon">@Icons.Book(28)</div>
                <h3>ოთახები ჯერ არ არის დამატებული</h3>
                <p>როგორც კი ადმინისტრატორი ოთახს დაამატებს, ის აქ გამოჩნდება.</p>
                @if (isAdmin)
                {
                    <a class="btn" asp-action="Create">@Icons.Plus() პირველი ოთახის დამატება</a>
                }
            </div>
        }
        else if (Model.Rooms.Count == 0)
        {
            <div class="empty">
                <div class="empty-icon">@Icons.Search(28)</div>
                <h3>ვერაფერი მოიძებნა</h3>
                <p>სცადე სხვა სიტყვა ან მოხსენი ზომის ფილტრი.</p>
                <a class="btn btn-ghost" asp-action="Index">ყველა ოთახის ჩვენება</a>
            </div>
        }
        else
        {
            <div class="book-grid">
                @foreach (var room in Model.Rooms)
                {
                    <partial name="_RoomCard" model="room" />
                }
            </div>
        }
    </div>
</div>
