@model MyBookings
@{
    ViewData["Title"] = "ჩემი ჯავშნები";
}
<div class="page">
    <div class="container" style="max-width:900px">
        <partial name="_Alerts" />
        <div class="page-head">
            <div>
                <span class="eyebrow">ჩემი თარო</span>
                <h1>ჩემი ჯავშნები</h1>
                <p>მომავალი ჯავშნები და ისტორია ერთ ადგილას.</p>
            </div>
            <a class="btn btn-ghost" asp-controller="Rooms" asp-action="Index">@Icons.Plus() ახალი ჯავშანი</a>
        </div>

        @if (Model.IsEmpty)
        {
            <div class="empty" data-testid="no-bookings">
                <div class="empty-icon">@Icons.Bookmark(28)</div>
                <h3>ჯავშნები ჯერ არ გაქვს</h3>
                <p>აირჩიე ოთახი კატალოგიდან და დაჯავშნე პირველი საათი.</p>
                <a class="btn" asp-controller="Rooms" asp-action="Index">ოთახების ნახვა @Icons.ArrowRight()</a>
            </div>
        }
        else
        {
            <h2 class="tabs-title">მომავალი <span class="count-pill">@Model.Upcoming.Count</span></h2>
            @if (Model.Upcoming.Count == 0)
            {
                <p class="muted" style="margin-bottom:40px">მომავალი ჯავშნები არ გაქვს.</p>
            }
            else
            {
                <div class="tickets">
                    @foreach (var b in Model.Upcoming)
                    {
                        <article class="ticket">
                            <div class="ticket-date">
                                <strong>@b.Date.Day</strong>
                                <span>@RoomStyle.MonthShort(b.Date)</span>
                            </div>
                            <div>
                                <h3>@(b.Room?.Name ?? $"ოთახი #{b.RoomId}")</h3>
                                <div class="meta">
                                    <span>@Icons.Clock(15) @($"{b.StartHour:00}:00–{b.StartHour + 1:00}:00")</span>
                                    <span>@Icons.Calendar(15) @RoomStyle.Weekday(b.Date)</span>
                                    @if (b.Room is not null)
                                    {
                                        <span>@Icons.Pin(15) @b.Room.Location</span>
                                    }
                                </div>
                            </div>
                            <form asp-action="Cancel" asp-route-id="@b.Id" method="post"
                                  onsubmit="return confirm('ნამდვილად გსურთ ჯავშნის გაუქმება?');">
                                <button type="submit" class="btn btn-sm btn-danger-outline">გაუქმება</button>
                            </form>
                        </article>
                    }
                </div>
            }

            <h2 class="tabs-title">ისტორია <span class="count-pill" style="background:var(--paper-deep);color:var(--ink-soft)">@Model.History.Count</span></h2>
            @if (Model.History.Count == 0)
            {
                <p class="muted">ისტორია ცარიელია.</p>
            }
            else
            {
                <div class="tickets">
                    @foreach (var b in Model.History)
                    {
                        var cancelled = b.Status == BookingStatus.Cancelled;
                        <article class="ticket @(cancelled ? "cancelled" : "past")">
                            <div class="ticket-date">
                                <strong>@b.Date.Day</strong>
                                <span>@RoomStyle.MonthShort(b.Date)</span>
                            </div>
                            <div>
                                <h3>@(b.Room?.Name ?? $"ოთახი #{b.RoomId}")</h3>
                                <div class="meta">
                                    <span>@Icons.Clock(15) @($"{b.StartHour:00}:00–{b.StartHour + 1:00}:00")</span>
                                </div>
                            </div>
                            <span class="status @(cancelled ? "status-cancelled" : "status-done")">@(cancelled ? "გაუქმებული" : "დასრულებული")</span>
                        </article>
                    }
                </div>
            }
        }
    </div>
</div>
