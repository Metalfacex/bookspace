@model RegisterViewModel
@{
    ViewData["Title"] = "რეგისტრაცია";
}
<div class="container">
    <div class="auth">
        <partial name="_AuthArt" model="@(("შენი ადგილი ბიბლიოთეკაში", "ერთი ანგარიში — ყველა სასწავლო ოთახი. დაჯავშნე, გააუქმე და მართე განრიგი ერთ ადგილას."))" />
        <div class="auth-form">
            <h1>რეგისტრაცია</h1>
            <p class="lead">ანგარიშის შექმნას ერთი წუთი სჭირდება.</p>
            <form asp-action="Register" method="post" novalidate>
                <div asp-validation-summary="ModelOnly"></div>
                <div class="form-field">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="name@uni.edu.ge" autocomplete="username" />
                    <span asp-validation-for="Email"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <div class="form-hint">მინიმუმ 8 სიმბოლო, ერთი ასო და ერთი ციფრი.</div>
                    <span asp-validation-for="Password"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>
                <button type="submit" class="btn btn-lg btn-block">ანგარიშის შექმნა</button>
            </form>
            <p class="form-foot">უკვე გაქვს ანგარიში? <a asp-action="Login">შესვლა</a></p>
        </div>
    </div>
</div>
