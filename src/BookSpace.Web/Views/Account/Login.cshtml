@model LoginViewModel
@{
    ViewData["Title"] = "შესვლა";
}
<div class="container">
    <div class="auth">
        <partial name="_AuthArt" model="@(("კეთილი იყოს შენი დაბრუნება", "შედი და გააგრძელე იქიდან, სადაც გაჩერდი — შენი ჯავშნები უკვე თაროზეა."))" />
        <div class="auth-form">
            <h1>შესვლა</h1>
            <p class="lead">გამოიყენე უნივერსიტეტის ელფოსტა.</p>
            <form asp-action="Login" method="post" novalidate>
                <div asp-validation-summary="ModelOnly"></div>
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="form-field">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" autocomplete="username" placeholder="name@uni.edu.ge" />
                    <span asp-validation-for="Email"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password"></span>
                </div>
                <button type="submit" class="btn btn-lg btn-block">შესვლა</button>
            </form>
            <p class="form-foot">არ გაქვს ანგარიში? <a asp-action="Register">დარეგისტრირდი</a></p>
        </div>
    </div>
</div>
