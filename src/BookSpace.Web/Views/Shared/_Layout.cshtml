<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — BookSpace</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-md navbar-dark bg-primary mb-4">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">BookSpace</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Rooms" asp-action="Index">ოთახები</a></li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Bookings" asp-action="My">ჩემი ჯავშნები</a></li>
                }
                @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Statistics" asp-action="Index">სტატისტიკა</a></li>
                }
            </ul>
            <ul class="navbar-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item"><span class="navbar-text me-3">@User.Identity.Name</span></li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm">გასვლა</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">შესვლა</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">რეგისტრაცია</a></li>
                }
            </ul>
        </div>
    </div>
</nav>
<main class="container pb-5">
    <partial name="_Alerts" />
    @RenderBody()
</main>
<footer class="border-top py-3 text-muted small">
    <div class="container">BookSpace · სასწავლო ოთახების დაჯავშნა</div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
