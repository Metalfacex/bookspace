@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string? a = null) =>
        controller == c && (a is null || action == a) ? "active" : "";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var initial = (User.Identity?.Name ?? "?").Substring(0, 1);
}
<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · BookSpace</title>
    <meta name="theme-color" content="#f7f2e9" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Georgian:wght@400;500;600;700&family=Noto+Serif+Georgian:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="site">
    <div class="topstrip">
        <div class="container">
            <span>@Icons.Clock(14) ღიაა ყოველდღე 08:00–22:00</span>
            <span class="hide-sm">@Icons.Bookmark(14) დღეში 3 საათამდე · 14 დღით ადრე</span>
        </div>
    </div>

    <header class="site-header">
        <div class="container">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="BookSpace — მთავარი">
                <span class="brand-mark">@Icons.Book(20)</span>
                <span>Book<em>Space</em></span>
            </a>

            <form class="nav-search" method="get" asp-controller="Rooms" asp-action="Index" role="search">
                @Icons.Search()
                <label for="nav-q" class="visually-hidden">ოთახის ძებნა</label>
                <input id="nav-q" name="q" type="search" placeholder="მოძებნე ოთახი ან კორპუსი…" value="@Context.Request.Query["q"]" />
            </form>

            <button class="nav-toggle" type="button" aria-label="მენიუ" aria-expanded="false" aria-controls="nav-links"
                    onclick="var n=document.getElementById('nav-links');var o=n.classList.toggle('open');this.setAttribute('aria-expanded',o)">
                @Icons.Menu()
            </button>

            <ul class="nav-links" id="nav-links">
                <li><a class="@Active("Rooms")" asp-controller="Rooms" asp-action="Index">ოთახები</a></li>
                @if (signedIn)
                {
                    <li><a class="@Active("Bookings")" asp-controller="Bookings" asp-action="My">ჩემი ჯავშნები</a></li>
                }
                @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager))
                {
                    <li><a class="@Active("Statistics")" asp-controller="Statistics" asp-action="Index">სტატისტიკა</a></li>
                }
                @if (signedIn)
                {
                    <li class="nav-user">
                        <span class="avatar" title="@User.Identity!.Name">@initial</span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="linklike btn-link-plain">@Icons.Logout() გასვლა</button>
                        </form>
                    </li>
                }
                else
                {
                    <li><a class="@Active("Account", "Login")" asp-controller="Account" asp-action="Login">შესვლა</a></li>
                    <li><a class="btn btn-sm" asp-controller="Account" asp-action="Register">რეგისტრაცია</a></li>
                }
            </ul>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <a class="brand" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark">@Icons.Book(18)</span>
                        <span>Book<em>Space</em></span>
                    </a>
                    <p style="margin-top:12px;max-width:36ch">უნივერსიტეტის სასწავლო ოთახები ერთ თაროზე — იპოვე, დაჯავშნე და იმეცადინე მშვიდად.</p>
                </div>
                <div>
                    <h4>ნავიგაცია</h4>
                    <ul>
                        <li><a asp-controller="Rooms" asp-action="Index">ყველა ოთახი</a></li>
                        <li><a asp-controller="Bookings" asp-action="My">ჩემი ჯავშნები</a></li>
                        <li><a asp-controller="Account" asp-action="Register">ანგარიშის შექმნა</a></li>
                    </ul>
                </div>
                <div>
                    <h4>წესები</h4>
                    <ul>
                        <li>სლოტი = 1 საათი</li>
                        <li>დღეში მაქსიმუმ 3 ჯავშანი</li>
                        <li>გაუქმება — დაწყებამდე</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© @DateTime.Now.Year BookSpace</span>
                <span>სასწავლო პროექტი · ASP.NET Core MVC</span>
            </div>
        </div>
    </footer>
</div>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
